# Copy to .env and fill in. Never commit .env.
#
# Docker Compose reads this file for ${VAR} substitution and as env_file.
# Inside containers, compose overrides hosts to postgres_db, redis_cache,
# and DOCUMENT_SERVICE_URL=http://ai-worker:8000/api/v1/ai.
# Values below are for tools on the host (localhost).

# --- Postgres ---
POSTGRES_USER=eike
POSTGRES_PASSWORD=change_me
POSTGRES_DB=eike
POSTGRES_PORT=5432
POSTGRES_HOST=localhost
DATABASE_URL=postgresql://eike:change_me@localhost:5432/eike


# --- Redis (BullMQ) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=eike_redis_password_2026
# --- AI worker (query HTTP + ingest process) ---
# API_KEY is Nest → FastAPI (X-Internal-Api-Key). Not a user JWT. Not for the browser.
AI_WORKER_HOST=0.0.0.0
AI_WORKER_PORT=8000
AI_WORKER_ALLOWED_HOSTS=localhost,127.0.0.1,ai-worker,gateway-service
API_KEY=replace_with_a_long_random_internal_key
LLAMA_PARSE_API_KEY=
GEMINI_CONTENT_EMBEDDING_API_KEY=
GEMINI_QUERY_EMBEDDING_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_CONTENT_GENERATE_API_KEY=
GEMINI_GENERATIVE_MODEL=gemini-2.5-flash

# --- Gateway (NestJS) ---
# JWT_SECRET must be at least 32 characters.
# CORS origin = the browser app (e.g. http://localhost:3000), not Caddy's port.
NODE_ENV=development
GATEWAY_SERVICE_PORT=3000
GATEWAY_SERVICE_CORS_ORIGIN=*
JWT_SECRET=replace_with_at_least_32_character_secret__
DOCUMENT_SERVICE_URL=http://localhost:8000/api/v1/ai

# --- S3 (private bucket; presigned browser PUT) ---
# Leave S3_ENDPOINT empty for AWS. Set only for MinIO, e.g. http://localhost:9000
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
