# Copy to .env and fill in secrets. Do not commit .env.
# Docker Compose reads this file for ${VAR} substitution and env_file.
# Container hostnames (postgres_db, redis_cache, ai-worker) are set in
# docker-compose.yaml and override any localhost values below.

# --- Postgres ---
POSTGRES_USER=eike
POSTGRES_PASSWORD=change_me
POSTGRES_DB=eike
POSTGRES_PORT=5432
# Host-only (apps on the laptop). Compose overrides this to postgres_db.
POSTGRES_HOST=localhost
DATABASE_URL=postgresql://eike:change_me@localhost:5432/eike

# --- Redis (BullMQ for the gateway and ingest worker) ---
REDIS_PORT=6379
# Host-only. Compose overrides this to redis_cache.
REDIS_HOST=localhost

# --- AI worker (query HTTP + ingest process) ---
AI_WORKER_PORT=8000
AI_WORKER_HOST=0.0.0.0
AI_WORKER_ALLOWED_ORIGINS=
AI_WORKER_ALLOWED_HOSTS=localhost,127.0.0.1,ai-worker,gateway-service
API_KEY=generate_a_long_random_internal_key
LLAMA_PARSE_API_KEY=
GEMINI_CONTENT_EMBEDDING_API_KEY=
GEMINI_QUERY_EMBEDDING_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_CONTENT_GENERATE_API_KEY=
GEMINI_GENERATIVE_MODEL=gemini-2.5-flash

# --- Gateway ---
GATEWAY_SERVICE_PORT=3000
NODE_ENV=development
GATEWAY_SERVICE_CORS_ORIGIN=*
JWT_SECRET=generate_a_long_random_jwt_secret_min_32_chars
# Host-only. Compose sets http://ai-worker:8000/api/v1/ai
DOCUMENT_SERVICE_URL=http://localhost:8000/api/v1/ai

# --- S3 (presigned browser PUT; private bucket; never public) ---
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Leave empty for AWS. Set only for MinIO, e.g. http://localhost:9000
S3_ENDPOINT=
